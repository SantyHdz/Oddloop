{
  "name": "backend",
  "version": "1.0.0",
  "description": "Odd Loop API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "private": true
}
